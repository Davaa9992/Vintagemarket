{
    "name": "vintage-back",
    "version": "1.0.0",
    "description": "Vintage хувцасны дэлгүүрийн backend (Node.js + TypeScript + MongoDB)",
    "type": "commonjs",
    "scripts": {
        "start": "npm run serve",
        "build": "tsc",
        "serve": "node dist/src/server.js",
        "dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
        "watch-ts": "tsc -w",
        "watch-node": "nodemon dist/src/server.js",
        "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"yellow.bold,cyan.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
        "test": "mocha",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
        "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
        "seed:prod": "node dist/src/scripts/seed.js"
    },
    "_moduleAliases": {
        "@root": "dist/src"
    },
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.0",
        "express": "^4.21.0",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "mongoose": "^8.8.0",
        "morgan": "^1.10.0",
        "winston": "^3.15.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/mocha": "^10.0.9",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.16.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "concurrently": "^9.0.0",
        "eslint": "^8.57.0",
        "mocha": "^10.7.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.3.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.0"
    }
}
