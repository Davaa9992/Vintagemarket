{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2020",
        "noImplicitAny": true,
        "strictNullChecks": false,
        "sourceMap": true,
        "outDir": "dist",
        "baseUrl": "./",
        "paths": {
            "@root/*": ["src/*"]
        },
        "skipLibCheck": true
    },
    "include": ["src/**/*", "tests/**/*"]
}
