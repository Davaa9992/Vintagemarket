NODE_ENV=development
NODE_PORT=5000
NODE_HOST=http://localhost:5000
FRONTEND_HOST=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
API_MAX_TIMEOUT_MS=100000

MONGODB_DEV_URI=mongodb://127.0.0.1:27017/vintage_dev
MONGODB_PROD_URI=

JWT_SECRET=change_me_to_a_long_random_string
# Cookie secure (https дээр true)
COOKIE_SECURE=false

# Анхны админ (npm run seed үед үүснэ). Утсаараа нэвтэрнэ
ADMIN_PHONE=99000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_123

# Жишээ 4 худалдагч (99110001-99110004) энэ нууц үгтэй үүснэ. Хоосон бол үүсгэхгүй
SEED_SELLER_PASSWORD=demo1234
