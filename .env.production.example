# Сайтын домэйн (www-гүй). DNS-ийн A record энэ серверийн IP руу заасан байх ёстой.
DOMAIN=vintage.mn

# Урт санамсаргүй мөр: openssl rand -hex 32
JWT_SECRET=

# Админ (seed үед үүснэ). Нууц үг 8+ тэмдэгт, үсэг ба тоотой
ADMIN_PHONE=
ADMIN_PASSWORD=

# Жишээ 4 дэлгүүр, 13 бараа хэрэгтэй бол нууц үг бичнэ (99110001-99110004). Хоосон бол үүсгэхгүй
SEED_SELLER_PASSWORD=
